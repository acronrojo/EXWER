{
  "manifest_version": 3,
  "name": "Verita Auto-Coder",
  "version": "5.0",
  "description": "Aplica bloques de código al proyecto actual.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}